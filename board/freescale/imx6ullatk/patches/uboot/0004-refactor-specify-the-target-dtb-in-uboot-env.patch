From f3623841330412826cdb4e48af0a290c80463665 Mon Sep 17 00:00:00 2001
From: SudekiMing <sudekiming@163.com>
Date: Fri, 28 Jul 2023 21:39:58 +0800
Subject: [PATCH] refactor: specify the target dtb in uboot env

- `imx6ull-14x14-atk.dtb` device tree for atk board is used by default in uboot env
---
 include/configs/mx6ullatk.h | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/include/configs/mx6ullatk.h b/include/configs/mx6ullatk.h
index bd26bab..21a2372 100644
--- a/include/configs/mx6ullatk.h
+++ b/include/configs/mx6ullatk.h
@@ -193,12 +193,7 @@
 		"fi;\0" \
 		"findfdt="\
 			"if test $fdt_file = undefined; then " \
-				"if test $board_name = EVK && test $board_rev = 9X9; then " \
-					"setenv fdt_file imx6ull-9x9-evk.dtb; fi; " \
-				"if test $board_name = EVK && test $board_rev = 14X14; then " \
-					"setenv fdt_file imx6ull-14x14-evk.dtb; fi; " \
-				"if test $fdt_file = undefined; then " \
-					"echo WARNING: Could not determine dtb to use; fi; " \
+				"setenv fdt_file imx6ull-14x14-atk.dtb; " \
 			"fi;\0" \
 
 #define CONFIG_BOOTCOMMAND \
-- 
2.7.4

